 namespace LIServiceVec {
 
+// Queue the next group in the other score buffer before consuming the current
+// group, so MTE2 can overlap vector scaling. The caller consumes MTE2_V and
+// releases V_MTE2 after scaling, exactly once for each group.
+__aicore__ inline void PrefetchCachedScores(AscendC::LocalTensor<float> scratch,
+    AscendC::GlobalTensor<float> scores, int64_t rowOffset, uint32_t keyStride,
+    uint32_t ubStride, uint32_t group)
+{
+    using namespace AscendC;
+    uint32_t slot = group % 2;
+    auto destination = scratch[slot * (16 * 512 + 512)];
+    WaitFlag<HardEvent::V_MTE2>(slot);
+    DataCopyPad(destination, scores[rowOffset + group * 16 * keyStride],
+        DataCopyExtParams{16, static_cast<uint32_t>(keyStride * sizeof(float)), 0, ubStride, 0},
+        DataCopyPadExtParams<float>{false, 0, 0, 0});
+    SetFlag<HardEvent::MTE2_V>(slot);
+}
